# --- OpenAI ---
OPENAI_API_KEY=sk-...
# Chat model (tool calling), temperature is fixed at 0.3 in code
OPENAI_MODEL=gpt-4o
# MUST stay text-embedding-3-small — the documents table was embedded with it;
# a different model silently breaks retrieval.
EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase (existing project with documents + qa_logs tables) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- CORS allow-list (comma-separated, never "*") ---
ALLOWED_ORIGINS=https://preacademy.app.clientclub.net

# --- Server ---
PORT=3000

# --- Comps lookup (optional — features gate themselves off when absent) ---
# Apify token for the Zillow scrapers. ABSENT => run_comps is not registered
# at all (the model cannot attempt a comps run); set_manual_arv still works.
APIFY_TOKEN=apify_api_...
# US Census ACS key (free: api.census.gov/data/key_signup.html). ABSENT =>
# the demographics section never renders — an unconfigured feature, not an
# error.
CENSUS_API_KEY=...
# Daily cap on LOOKUPS that touch Apify (up to 3 actor runs each; all-cache
# lookups are free). Optional; defaults to 50.
# COMPS_DAILY_RUN_CAP=50
# NOTE: retry/backoff knobs (e.g. DETAIL_BATCH_MAX_RETRIES) are code
# constants in src/features/comps/config.ts by design (CONTRACT §3: zero
# magic numbers, no env overrides) — they are deliberately not env vars.

# --- Retrieval tuning (optional) ---
MATCH_COUNT=5
MATCH_THRESHOLD=0

# --- Demo page (optional) ---
# GET /demo hosts the chat widget on the API's own origin — see the bot without
# a GHL page. Always on outside production; in production it is OFF unless:
# ENABLE_DEMO_PAGE=true

# --- GHL access gating (Phase 3) -------------------------------------------
# Private integration token. Scopes: contacts read REQUIRED; custom-field
# definitions read wanted (without it the Course Access field id cannot be
# verified at boot and stays inferred — see reports/GHL_FIELD_SHAPE.md #1).
GHL_API_TOKEN=
GHL_LOCATION_ID=EDY094ip0U3HwMFQYsVy
# Course Access dropdown field id. INFERRED from probe evidence until the
# definitions scope lands; env-overridable so a wrong id is fixable without a
# code deploy.
GHL_COURSE_ACCESS_FIELD_ID=axyDeZQxj7gMCtV1FyxS
# HMAC key for member session tokens (S2). Generate long and random; rotating
# it invalidates every live session.
SESSION_SIGNING_KEY=

# --- Phase 3 unconditional limits (defaults shown; override to tune) --------
# Per-IP on /auth is LOAD-BEARING: enumeration probes use distinct emails, and
# each probe costs a real GHL call — this protects the client's GHL quota as
# much as member privacy. Per-email is load-bearing on /chat.
AUTH_IP_LIMIT_PER_MIN=10
CHAT_MEMBER_LIMIT_PER_MIN=20
CHAT_IP_LIMIT_PER_MIN=40
# Per-member slice of the global COMPS_DAILY_RUN_CAP pool — one member can no
# longer exhaust every member's daily allowance.
COMPS_MEMBER_DAILY_CAP=5
MAX_MESSAGE_CHARS=4000
